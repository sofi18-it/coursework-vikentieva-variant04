<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>Library Reservation Server</display-name>

    <servlet>
        <servlet-name>EditionServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.servlet.EditionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EditionServlet</servlet-name>
        <url-pattern>/editions</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReaderServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.servlet.ReaderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReaderServlet</servlet-name>
        <url-pattern>/readers</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReservationServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.servlet.ReservationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReservationServlet</servlet-name>
        <url-pattern>/reservations</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoanServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.servlet.LoanServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoanServlet</servlet-name>
        <url-pattern>/loans</url-pattern>
    </servlet-mapping>
</web-app>
